{
  "version": 2,
  "rewrites": [
    { "source": "/api/home", "destination": "/api/home" },
    { "source": "/api/checkout/:path*", "destination": "/api/orders" },
    { "source": "/api/guest/:path*", "destination": "/api/orders" },
    { "source": "/api/orders", "destination": "/api/orders" },
    { "source": "/api/orders/:path*", "destination": "/api/orders" },
    { "source": "/api/payments/:path*", "destination": "/api/payments" },
    { "source": "/api/track/:path*", "destination": "/api/track" },
    { "source": "/api/rider/:path*", "destination": "/api/rider" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
