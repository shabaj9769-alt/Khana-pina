# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Used on backend for double-verified payment creation & HMAC-SHA256 verification.
# Defaults to test mode simulation when not set or starting with rzp_test_
RAZORPAY_KEY_ID="rzp_test_aangan_demo_key"
RAZORPAY_KEY_SECRET="rzp_test_secret_hmac_key_2026"
RAZORPAY_WEBHOOK_SECRET="whsec_aangan_razorpay_webhook_2026"

# ADMIN_JWT_SECRET: Used for signing admin session tokens
ADMIN_JWT_SECRET="aangan_admin_jwt_secret_key_change_in_prod"

# TURNSTILE_SECRET_KEY: Cloudflare Turnstile / Captcha verification secret
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

